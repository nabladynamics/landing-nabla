# Server-side — required for the contact form to deliver email via Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional. Sender shown on contact emails. Requires a domain verified in
# Resend; until then the form sends from onboarding@resend.dev.
# CONTACT_FROM_EMAIL="Nabla AI <hello@yourdomain.com>"

# Optional. Canonical URL for metadata / Open Graph.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional. Overrides the form target if you ever want to bypass the built-in
# /api/contact route (e.g. Formspree).
# NEXT_PUBLIC_CONTACT_ENDPOINT=

# Private visitor statistics. These values must stay server-side.
# Enable Web Analytics in the Nabla Vercel project before deploying.
VISITOR_STATS_PASSWORD=
VISITOR_STATS_VERCEL_TOKEN=
VISITOR_STATS_PROJECT_ID=
# Supply the team's ID or slug (not both).
VISITOR_STATS_TEAM_SLUG=nabla-ai-s-projects
# VISITOR_STATS_TEAM_ID=
